#!/usr/bin/env bash
# Install and configure HAProxy to balance traffic between web-01 and web-02

set -e

# Update package lists
sudo apt-get update

# Install HAProxy
sudo apt-get install -y haproxy

# Configure HAProxy
sudo tee /etc/haproxy/haproxy.cfg <<'EOF'
global
    log /dev/log local0
    log /dev/log local1 notice
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    server web-01 10.30.31.159:80 check
    server web-02 10.30.26.93:80 check
EOF

# Validate HAProxy configuration
sudo haproxy -c -f /etc/haproxy/haproxy.cfg

# Enable HAProxy at startup and manage it through its init script
sudo update-rc.d haproxy defaults
sudo service haproxy restart
