
#!/usr/bin/env bash
# Install and configure HAProxy to distribute traffic between web-01 and web-02

set -e

apt-get update
apt-get install -y haproxy

cat > /etc/haproxy/haproxy.cfg <<'EOF'
global
    log /dev/log local0
    log /dev/log local1 notice
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    server web-01 10.30.31.159:80 check
    server web-02 10.30.26.93:80 check
EOF

haproxy -c -f /etc/haproxy/haproxy.cfg
systemctl enable haproxy
systemctl restart haproxy
