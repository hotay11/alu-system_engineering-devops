#!/usr/bin/env bash
# Installs Nginx and adds a custom X-Served-By header containing the server hostname
sudo apt-get update -y
sudo apt-get install -y nginx

if ! grep -q "X-Served-By" /etc/nginx/sites-available/default; then
    sudo sed -i "/server_name _;/a \\\tadd_header X-Served-By $(hostname);" /etc/nginx/sites-available/default
fi

sudo service nginx restart
